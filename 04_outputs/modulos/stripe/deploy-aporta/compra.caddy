# Copiado por vps.sh desde deploy-aporta (CON-533, CON-535 y CON-546).
compra.aporta-epi10.com {
	import aporta_comun

	# Stripe no puede pasar por la puerta; el receptor verifica la firma de cada evento.
	@protegido not path /api/webhooks/stripe
	import puerta @protegido

	reverse_proxy epi10-compra-web:3000
}
