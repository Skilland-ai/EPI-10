ion:absolute;bottom:37px;right:47px}.intro-strip{border-top:1px solid var(--line);justify-content:space-between;align-items:center;gap:25px;padding-block:33px;display:flex}.intro-strip p{letter-spacing:-.035em;color:var(--muted);font-size:19px;line-height:1.5}.intro-strip strong{color:var(--ink);font-weight:500}.intro-strip>span{letter-spacing:.12em;font-size:.875rem}.skip-link{z-index:100;background:#fff;padding:12px;position:fixed;top:-100px;left:20px}.skip-link:focus{top:12px}@media (max-width:900px){.shell{width:calc(100% - 48px)}.hero{gap:30px}.header-caption{display:none}h1{font-size:60px}.hero-visual{min-height:580px}.hero-purchase{flex-wrap:wrap;gap:15px}.hero-footnote{margin-top:26px}}@media (max-width:640px){.shell{width:calc(100% - 40px)}.site-header{gap:20px;height:80px}.brand img{width:110px}.header-link{gap:13px;font-size:1rem}.hero{grid-template-columns:1fr;gap:28px;padding-top:0;padding-bottom:35px}.hero-copy{padding-top:19px}h1{margin-top:24px;font-size:clamp(58px,15vw,80px)}.hero-description{max-width:420px}.hero-visual{min-height:470px}.hero-footnote{display:none}.intro-strip{flex-direction:column;align-items:flex-start}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,:before,:after{transition:none!important;animation:none!important}}.main-nav{color:var(--muted);gap:32px;font-size:1rem;display:flex}.main-nav a:hover{color:var(--blue)}h2{letter-spacing:-.055em;font-size:clamp(42px,4.6vw,65px);font-weight:500;line-height:1.08}h2 em{color:var(--blue);letter-spacing:-.025em}.offer-section{grid-template-columns:1fr 1.08fr;gap:80px;padding-top:100px;padding-bottom:112px;display:grid}.section-intro h2{margin-top:28px}.section-intro>p:last-of-type{max-width:350px;color:var(--muted);margin-top:24px;font-size:1.125rem;line-height:1.85}.editorial-note{align-items:center;gap:20px;margin-top:51px;display:flex}.note-mark{color:var(--blue);font-size:40px;font-weight:300}.editorial-note p{color:var(--muted);font-size:1rem;line-height:1.8}.editorial-note strong{color:var(--ink);font-weight:500}.service-list{margin:0;padding:0;list-style:none}.service-list li{border-bottom:1px solid var(--line);grid-template-columns:25px 1fr 10px;gap:20px;padding:22px 0;display:grid}.service-list li:first-child{padding-top:0}.service-index{color:var(--blue);font-variant-numeric:tabular-nums;padding-top:5px;font-size:.875rem}.service-list h3{letter-spacing:-.035em;font-size:1.5rem;font-weight:500}.service-list p{color:var(--muted);max-width:440px;margin-top:9px;font-size:1.125rem;line-height:1.7}.service-dot{background:#96c7d2;border-radius:50%;width:6px;height:6px;margin-top:10px}.experience{color:#fff;background:#082f49;padding-block:78px 30px}.experience-heading{grid-template-columns:1fr 1.08fr;gap:20px 80px;display:grid}.experience-heading .eyebrow{color:#a4e7ed;grid-column:1/-1}.experience h2 em{color:#8ae1e5}.experience-heading>p:last-child{color:#bfd0db;align-self:end;max-width:370px;padding-bottom:5px;font-size:1.125rem;line-height:1.85}.journey{grid-template-columns:repeat(3,1fr);gap:0;margin:58px 0 0;padding:0;list-style:none;display:grid}.journey li{border-top:1px solid #ffffff35;border-right:1px solid #ffffff25;padding:25px 28px 35px}.journey li:first-child{padding-left:0}.journey li:last-child{border-right:0;padding-right:0}.journey-top{color:#8ae1e5;justify-content:space-between;align-items:center;padding-bottom:25px;display:flex}.journey-top span:first-child{letter-spacing:.12em;font-size:.875rem}.journey-top span:last-child{font-size:25px;font-weight:300}.journey h3{letter-spacing:-.035em;font-size:1.5rem;font-weight:450}.journey p{color:#bfd0db;max-width:300px;margin-top:13px;font-size:1.125rem;line-height:1.9}.journey-label{color:#8ae1e5;letter-spacing:.12em;margin-top:30px;font-size:.875rem;display:block}.experience-note{color:#b5cad4;border-top:1px solid #ffffff25;padding-top:21px;font-size:1rem;line-height:1.7}.purchase-section{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center;gap:8