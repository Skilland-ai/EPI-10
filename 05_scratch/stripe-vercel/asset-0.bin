kground:#22666c}.questions{border-top:1px solid var(--line);grid-template-columns:1fr 1.08fr;gap:80px;padding-block:55px 75px;display:grid}.questions h2{font-size:35px}.questions details{border-bottom:1px solid var(--line);padding-block:17px}.questions details:first-child{padding-top:0}.questions summary{cursor:pointer;justify-content:space-between;align-items:center;gap:25px;min-height:44px;font-size:1rem;font-weight:500;list-style:none;display:flex}.questions summary::-webkit-details-marker{display:none}.questions summary span{color:var(--blue);font-size:22px;line-height:1;transition:transform .2s}.questions details[open] summary span{transform:rotate(45deg)}.questions details p{color:var(--muted);margin-top:15px;padding-right:30px;font-size:1rem;line-height:1.85}.site-footer{border-top:1px solid var(--line);justify-content:space-between;align-items:center;gap:35px;padding-block:32px;display:flex}.site-footer .brand img{width:100px}.site-footer>p{color:var(--muted);margin-right:auto;font-size:1rem;line-height:1.6}.site-footer>div{text-align:right;color:var(--muted)}.site-footer>div>span{letter-spacing:.13em;font-size:.875rem}.site-footer>div>p{margin-top:5px;font-size:.875rem}@media (prefers-reduced-motion:no-preference){.hero-copy{animation:.65s ease-out both arrive}.hero-visual{animation:.8s ease-out .1s both arrive}@keyframes arrive{0%{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}}@media (max-width:1000px){.offer-section,.purchase-section,.questions{gap:40px}.experience-heading{gap:20px 40px}.purchase-card{padding:26px}.journey li{padding-inline:20px}.journey h3{font-size:1.375rem}}@media (max-width:760px){.main-nav{display:none}.offer-section,.purchase-section{gap:30px}.journey{grid-template-columns:1fr}.journey li,.journey li:first-child,.journey li:last-child{border-right:0;padding:24px 0}.journey-top{padding-bottom:13px}.journey-label{margin-top:17px}.journey p{max-width:100%}}@media (max-width:640px){.main-nav{display:none}h2{